<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox id="masterContainer" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.PracticeController">
  <children>
      <HBox id="masterControlsContainer" fx:id="controlsContainer">
          <VBox.margin>
              <Insets top="60.0" />
          </VBox.margin>
          <children>
          <VBox id="leftControlContainer" styleClass="control-box" HBox.hgrow="ALWAYS" />
          <AnchorPane fx:id="practicePane">
            <children>
                  <VBox id="practiceContainer">
                     <children>
                         <Text id="title" text="Practice Mode">
                             <VBox.margin>
                                <Insets bottom="100" />
                             </VBox.margin>
                         </Text>
                        <HBox id="totalCounterContainer" styleClass="counterContainer">
                           <children>
                              <Text id="totalLabel" fx:id="totalWords" styleClass="label" text="Total Words:">
                                  <HBox.margin>
                                      <Insets right="20" />
                                  </HBox.margin>
                               </Text>
                              <Text id="totalCounter" fx:id="totalCounter" styleClass="counter" />
                           </children>
                           <VBox.margin>
                                <Insets bottom="20" />
                           </VBox.margin>
                        </HBox>
                        <HBox id="correctCounterContainer" styleClass="counterContainer">
                           <children>
                               <Text id="correctLabel" fx:id="correctWords" styleClass="label" text="Correct:">
                                  <HBox.margin>
                                      <Insets right="20" />
                                  </HBox.margin>
                               </Text>
                              <Text id="correctCounter" fx:id="correctCounter" styleClass="counter" />
                           </children>
                           <VBox.margin>
                                <Insets bottom="50" />
                           </VBox.margin>
                        </HBox>
                        <TextArea id="wordsArea" fx:id="wordsArea" styleClass="text-area" editable="false">
                            <VBox.margin>
                                <Insets bottom="20" />
                            </VBox.margin>
                        </TextArea>
                        <TextArea id="typingArea" fx:id="typingArea" styleClass="text-area" onKeyTyped="#checkTypedWords" promptText="Start typing here..." />
                     </children>
                  </VBox>
            </children>
          </AnchorPane>
          <VBox id="rightControlContainer" styleClass="control-box" HBox.hgrow="ALWAYS">
               <children>
                  <HBox id="sentencesToggleContainer" styleClass="control-container">
                     <children>
                         <ToggleButton id="sentencesToggle" fx:id="sentencesToggle" mnemonicParsing="false" onAction="#togglePracticeWords" styleClass="toggle" text="Format">
                            <HBox.margin>
                                <Insets right="5" />
                            </HBox.margin>
                         </ToggleButton>
                        <Spinner id="sentenceCounter" fx:id="sentenceCounter" onMouseReleased="#updateSentenceCount" styleClass="spinner" />
                     </children>
                  </HBox>
               </children></VBox>
         </children>
      </HBox>
      <HBox id="navigationContainer" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
         <children>
             <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
                <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
             <Button id="homeBtn" mnemonicParsing="false" onAction="#displayHomepage" styleClass="navigation-btn" text="Home">
                 <HBox.margin>
                    <Insets right="30.0" />
                 </HBox.margin>
             </Button>
            <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
         </children>
      </HBox>
  </children>
</VBox>
