<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox id="masterContainer" style="-fx-alignment: center;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.PracticeController">
  <children>
    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" />
                  <VBox id="practiceContainer">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                               <ToggleButton id="sentencesToggle" fx:id="sentencesToggle" mnemonicParsing="false" onAction="#togglePracticeWords" styleClass="toggle" text="Format">
                                  <HBox.margin>
                                      <Insets right="5" />
                                  </HBox.margin>
                               </ToggleButton>
                              <Spinner id="sentenceCounter" fx:id="sentenceCounter" onMouseReleased="#updateSentenceCount" styleClass="spinner" />
                           </children>
                        </HBox>
                         <Text id="title" strokeType="OUTSIDE" strokeWidth="0.0" text="Practice Mode">
                             <VBox.margin>
                                <Insets bottom="100" />
                             </VBox.margin>
                         </Text>
                        <HBox prefWidth="200.0" style="-fx-alignment: center;">
                           <children>
                              <Text id="totalLabel" fx:id="totalWords" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="label" text="Total Words:">
                                  <HBox.margin>
                                      <Insets right="20" />
                                  </HBox.margin>
                               </Text>
                              <Text id="totalCounter" fx:id="totalCounter" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="counter" />
                           </children>
                           <VBox.margin>
                                <Insets bottom="20" />
                           </VBox.margin>
                        </HBox>
                        <HBox prefWidth="200.0" style="-fx-alignment: center;">
                           <children>
                               <Text id="correctLabel" fx:id="correctWords" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="label" text="Correct:">
                                  <HBox.margin>
                                      <Insets right="20" />
                                  </HBox.margin>
                               </Text>
                              <Text id="correctCounter" fx:id="correctCounter" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="counter" />
                           </children>
                           <VBox.margin>
                                <Insets bottom="50" />
                           </VBox.margin>
                        </HBox>
                        <TextArea id="wordsArea" fx:id="wordsArea" editable="false" focusTraversable="false" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="500.0" styleClass="text-area" wrapText="true">
                            <VBox.margin>
                                <Insets bottom="20" />
                            </VBox.margin>
                        </TextArea>
                         <TextArea id="typingArea" fx:id="typingArea" focusTraversable="false" maxHeight="-Infinity" maxWidth="-Infinity" onKeyTyped="#checkTypedWords" prefHeight="30.0" prefWidth="500.0" styleClass="text-area" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" />
               </children>
            </HBox>
      </children>
    </AnchorPane>
      <HBox id="navContainer" prefHeight="100.0" prefWidth="200.0">
         <children>
             <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
                <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
             <Button id="homeBtn" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#displayHomepage" styleClass="navigation-btn" text="Home">
                 <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
            <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
         </children>
      </HBox>
  </children>
</VBox>
