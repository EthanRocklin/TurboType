<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.HomepageController">
    <VBox id="homepageContainer" styleClass="main-container">
      <children>
          <Text id="turboTitle" styleClass="home-title" text="Turbo" />
          <Text id="typeTitle" styleClass="home-title" text="Type">
            <VBox.margin>
                  <Insets bottom="100" />
            </VBox.margin>
          </Text>
          <Button id="practiceBtn" mnemonicParsing="false" onAction="#displayPractice" styleClass="navigation-btn" text="Practice">
              <VBox.margin>
                  <Insets bottom="30.0" />
              </VBox.margin>
          </Button>
          <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
              <VBox.margin>
                  <Insets bottom="30.0" />
              </VBox.margin>
          </Button>
          <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
      </children>
    </VBox>
    <MenuBar id="menuBar" StackPane.alignment="TOP_LEFT">
        <menus>
            <Menu styleClass="menu" text="Export">
                <items>
                    <MenuItem fx:id="txtOption" styleClass="menu-item" mnemonicParsing="false" text=".txt"/>
                    <MenuItem fx:id="xslxOption" styleClass="menu-item" mnemonicParsing="false" text=".xslx"/>
                    <MenuItem fx:id="docxOption" styleClass="menu-item" mnemonicParsing="false" text=".docx"/>
                    <MenuItem fx:id="pdfOption" styleClass="menu-item" mnemonicParsing="false" text=".pdf"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Music">
                <items>
                    <MenuItem fx:id="classicalOption" styleClass="menu-item" mnemonicParsing="false" text="Classical"/>
                    <MenuItem fx:id="dubstepOption" styleClass="menu-item" mnemonicParsing="false" text="Dubstep"/>
                    <MenuItem fx:id="jazzOption" styleClass="menu-item" mnemonicParsing="false" text="Jazz"/>
                    <MenuItem fx:id="popOption" styleClass="menu-item" mnemonicParsing="false" text="Pop"/>
                    <MenuItem fx:id="rockOption" styleClass="menu-item" mnemonicParsing="false" text="Rock"/>
                    <MenuItem fx:id="technoOption" styleClass="menu-item" mnemonicParsing="false" text="Techno"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Theme">
                <items>
                    <MenuItem fx:id="motherNatureOption" styleClass="menu-item" mnemonicParsing="false" text="Mother Nature"/>
                    <MenuItem fx:id="purpleParadiseOption" styleClass="menu-item" mnemonicParsing="false" text="Purple Paradise"/>
                    <MenuItem fx:id="tronOption" styleClass="menu-item" mnemonicParsing="false" text="Tron"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>
</StackPane>