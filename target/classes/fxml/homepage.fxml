<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox id="homepageContainer" styleClass="main-container" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.HomepageController">
  <children>
      <Text id="turboTitle" styleClass="home-title" text="Turbo" />
      <Text id="typeTitle" styleClass="home-title" text="Type">
        <VBox.margin>
              <Insets bottom="100" />
        </VBox.margin>
      </Text>
      <Button id="practiceBtn" mnemonicParsing="false" onAction="#displayPractice" styleClass="navigation-btn" text="Practice">
          <VBox.margin>
              <Insets bottom="30.0" />
          </VBox.margin>
      </Button>
      <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
          <VBox.margin>
              <Insets bottom="30.0" />
          </VBox.margin>
      </Button>
      <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
  </children>
</VBox>
