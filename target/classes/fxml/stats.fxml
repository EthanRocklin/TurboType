<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox id="masterContainer" style="-fx-alignment: center;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.StatsController">
  <children>
    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
            <VBox id="statsContainer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Text id="title" text="Statistics" />
               </children>
            </VBox>
      </children>
    </AnchorPane>
      <HBox id="navContainer">
         <children>
             <Button id="practiceBtn" onAction="#displayPractice" styleClass="navigation-btn" pickOnBounds="false" text="Practice">
                 <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
             <Button id="homeBtn" onAction="#displayHomepage" styleClass="navigation-btn" pickOnBounds="false" text="Home">
                 <HBox.margin>
                    <Insets right="30.0" />
                 </HBox.margin>
             </Button>
            <Button id="timedBtn" onAction="#displayTimed" styleClass="navigation-btn" pickOnBounds="false" text="Timed" />
         </children>
      </HBox>
  </children>
</VBox>
