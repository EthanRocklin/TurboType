<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import java.lang.String?>

<HBox id="menuBarContainer" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.typingspeed.app.MenuBarController" HBox.hgrow="ALWAYS">
    <MenuBar id="menuBar">
        <menus>
            <Menu styleClass="menu" text="Export">
                <items>
                    <MenuItem fx:id="txtOption" styleClass="menu-item" mnemonicParsing="false" text=".txt"/>
                    <MenuItem fx:id="xslxOption" styleClass="menu-item" mnemonicParsing="false" text=".xslx"/>
                    <MenuItem fx:id="docxOption" styleClass="menu-item" mnemonicParsing="false" text=".docx"/>
                    <MenuItem fx:id="pdfOption" styleClass="menu-item" mnemonicParsing="false" text=".pdf"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Music">
                <items>
                    <MenuItem fx:id="classicalOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Classical"/>
                    <MenuItem fx:id="dubstepOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Dubstep"/>
                    <MenuItem fx:id="jazzOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Jazz"/>
                    <MenuItem fx:id="popOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Pop"/>
                    <MenuItem fx:id="rockOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Rock"/>
                    <MenuItem fx:id="technoOption" styleClass="menu-item" onAction="#handleMusicChange" mnemonicParsing="false" text="Techno"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Theme">
                <items>
                    <MenuItem fx:id="originalOption" styleClass="menu-item" onAction="#handleThemeChange" mnemonicParsing="false" text="Original"/>
                    <MenuItem fx:id="motherNatureOption" styleClass="menu-item" onAction="#handleThemeChange" mnemonicParsing="false" text="Nature"/>
                    <MenuItem fx:id="purpleParadiseOption" styleClass="menu-item" onAction="#handleThemeChange" mnemonicParsing="false" text="Purple Paradise"/>
                    <CustomMenuItem fx:id="tronOption" styleClass="menu-item">
                        <content>
                            <HBox>
                                <Label text="Tron">
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </Label>
                                <ComboBox id="colorBox" fx:id="colorBox" onAction="#handleTronTheme" promptText="Pick a Color">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="White" />
                                            <String fx:value="Red" />
                                            <String fx:value="Orange" />
                                            <String fx:value="Yellow" />
                                            <String fx:value="Lime" />
                                            <String fx:value="Green" />
                                            <String fx:value="Turquoise" />
                                            <String fx:value="Cyan" />
                                            <String fx:value="Purple" />
                                            <String fx:value="Pink" />
                                            <String fx:value="Hot Magenta" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </HBox>
                        </content>
                    </CustomMenuItem>
                </items>
            </Menu>
        </menus>
    </MenuBar>
    <fx:include source="music_panel.fxml" />
</HBox>