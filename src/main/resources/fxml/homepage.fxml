<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.HomepageController">
    <top>
        <fx:include source="menu_bar.fxml" />
    </top>
    <center>
        <VBox id="homepageContainer" styleClass="main-container">
          <children>
              <Text id="turboTitle" styleClass="home-title" text="Turbo" />
              <Text id="typeTitle" styleClass="home-title" text="Type">
                <VBox.margin>
                      <Insets bottom="100" />
                </VBox.margin>
              </Text>
              <Button id="practiceBtn" mnemonicParsing="false" onAction="#displayPractice" styleClass="navigation-btn" text="Practice">
                  <VBox.margin>
                      <Insets bottom="30.0" />
                  </VBox.margin>
              </Button>
              <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
                  <VBox.margin>
                      <Insets bottom="30.0" />
                  </VBox.margin>
              </Button>
              <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics">
                  <VBox.margin>
                      <Insets bottom="30.0" />
                  </VBox.margin>
              </Button>
              <Button id="creditsBtn" mnemonicParsing="false" onAction="#displayCredits" styleClass="navigation-btn" text="Credits" />
          </children>
        </VBox>
    </center>
</BorderPane>
