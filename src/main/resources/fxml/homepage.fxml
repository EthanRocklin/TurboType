<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<VBox id="homepageContainer" alignment="CENTER" prefHeight="600.0" prefWidth="900.0" styleClass="main-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.HomepageController">
  <children>
      <Text id="turboTitle" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="home-title" text="Turbo" />
      <Text id="typeTitle" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="home-title" text="Type" />
      <Region prefHeight="100" />
      <Button id="practiceBtn" mnemonicParsing="false" onAction="#displayPractice" styleClass="navigation-btn" text="Practice">
          <VBox.margin>
              <Insets bottom="30.0" />
          </VBox.margin>
      </Button>
      <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
          <VBox.margin>
              <Insets bottom="30.0" />
          </VBox.margin>
      </Button>
      <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
  </children>
</VBox>
