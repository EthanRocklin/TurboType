<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import java.lang.String?>

<HBox id="menuBarContainer" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.typingspeed.app.MenuBarController" HBox.hgrow="ALWAYS">
    <MenuBar id="menuBar" fx:id="menuBar">
        <menus>
            <Menu styleClass="menu" text="Export">
                <items>
                    <MenuItem fx:id="csvOption" styleClass="menu-item" onAction="#handleExport" text=".csv"/>
                    <MenuItem fx:id="docxOption" styleClass="menu-item" onAction="#handleExport" text=".docx"/>
                    <MenuItem fx:id="pdfOption" styleClass="menu-item" onAction="#handleExport" text=".pdf"/>
                    <MenuItem fx:id="txtOption" styleClass="menu-item" onAction="#handleExport" text=".txt"/>
                    <MenuItem fx:id="xslxOption" styleClass="menu-item" onAction="#handleExport" text=".xslx"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Music">
                <items>
                    <MenuItem fx:id="classicalOption" styleClass="menu-item" onAction="#handleGenreChange" text="Classical"/>
                    <MenuItem fx:id="dubstepOption" styleClass="menu-item" onAction="#handleGenreChange" text="Dubstep"/>
                    <MenuItem fx:id="jazzOption" styleClass="menu-item" onAction="#handleGenreChange" text="Jazz"/>
                    <MenuItem fx:id="popOption" styleClass="menu-item" onAction="#handleGenreChange" text="Pop"/>
                    <MenuItem fx:id="rockOption" styleClass="menu-item" onAction="#handleGenreChange" text="Rock"/>
                    <MenuItem fx:id="technoOption" styleClass="menu-item" onAction="#handleGenreChange" text="Techno"/>
                </items>
            </Menu>
            <Menu styleClass="menu" text="Theme">
                <items>
                    <MenuItem fx:id="originalOption" styleClass="menu-item" onAction="#handleThemeChange" text="Original"/>
                    <MenuItem fx:id="motherNatureOption" styleClass="menu-item" onAction="#handleThemeChange" text="Nature"/>
                    <MenuItem fx:id="purpleParadiseOption" styleClass="menu-item" onAction="#handleThemeChange" text="Purple Paradise"/>
                    <CustomMenuItem fx:id="tronOption" styleClass="menu-item">
                        <content>
                            <HBox>
                                <Label text="Tron">
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </Label>
                                <ComboBox id="colorBox" fx:id="colorBox" onAction="#handleTronTheme" promptText="Pick a Color">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="White" />
                                            <String fx:value="Red" />
                                            <String fx:value="Orange" />
                                            <String fx:value="Yellow" />
                                            <String fx:value="Lime" />
                                            <String fx:value="Green" />
                                            <String fx:value="Turquoise" />
                                            <String fx:value="Cyan" />
                                            <String fx:value="Purple" />
                                            <String fx:value="Pink" />
                                            <String fx:value="Hot Magenta" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </HBox>
                        </content>
                    </CustomMenuItem>
                </items>
            </Menu>
        </menus>
    </MenuBar>
    <VBox id="musicPanel">
        <HBox.margin>
            <Insets left="20" />
        </HBox.margin>
        <HBox id="controlsContainer">
            <Button id="backBtn" fx:id="backBtn" styleClass="music-btn" onAction="#handlePreviousTrack">
                <graphic>
                    <SVGPath id="backBtnIcon" styleClass="btn-icon" content="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                </graphic>
                <HBox.margin>
                    <Insets right="5" />
                </HBox.margin>
            </Button>
            <Button id="pauseBtn" fx:id="pauseBtn" styleClass="music-btn" onMouseClicked="#handlePausePlay">
                <graphic>
                    <SVGPath id="pauseBtnIcon" fx:id="pauseBtnIcon" styleClass="btn-icon" content="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                </graphic>
                <HBox.margin>
                    <Insets right="5" />
                </HBox.margin>
            </Button>
            <Button id="forwardBtn" fx:id="forwardBtn" styleClass="music-btn" onAction="#handleNextTrack">
                <graphic>
                    <SVGPath id="forwardBtnIcon" styleClass="btn-icon" content="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                </graphic>
                <HBox.margin>
                    <Insets right="15" />
                </HBox.margin>
            </Button>
            <Text id="currentTrackText" fx:id="currentTrackText" />
        </HBox>
    </VBox>
</HBox>
