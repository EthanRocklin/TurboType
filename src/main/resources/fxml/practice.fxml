<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox id="masterContainer" style="-fx-alignment: center;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.PracticeController">
  <children>
    <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="640.0" VBox.vgrow="ALWAYS">
      <children>
            <VBox id="practiceContainer" prefHeight="300.0" prefWidth="640.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Text id="title" strokeType="OUTSIDE" strokeWidth="0.0" text="Practice Mode" />
                  <TextField id="wordsField" fx:id="wordsField" editable="false" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="448.0" styleClass="text-field" />
                  <TextField id="typingField" fx:id="typingField" maxHeight="-Infinity" maxWidth="-Infinity" onKeyTyped="#getTypedWords" prefHeight="30.0" prefWidth="487.0" styleClass="text-field" />
               </children>
            </VBox>
      </children>
    </AnchorPane>
      <HBox id="navContainer" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed" />
            <Button id="homeBtn" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#displayHomepage" styleClass="navigation-btn" text="Home" />
            <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
         </children>
      </HBox>
  </children>
</VBox>
