<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox id="masterContainer" style="-fx-alignment: center;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.typingspeed.app.PracticeController">
  <children>
    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
            <VBox id="practiceContainer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                   <Text id="title" strokeType="OUTSIDE" strokeWidth="0.0" text="Practice Mode">
                       <VBox.margin>
                          <Insets bottom="200" />
                       </VBox.margin>
                   </Text>
                  <TextArea id="wordsArea" fx:id="wordsArea" editable="false" focusTraversable="false"  wrapText="true" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="500.0" styleClass="text-area">
                      <VBox.margin>
                          <Insets bottom="20" />
                      </VBox.margin>
                  </TextArea>
                   <TextArea id="typingArea" fx:id="typingArea" focusTraversable="false" wrapText="true" maxHeight="-Infinity" maxWidth="-Infinity" onKeyTyped="#getTypedWords" prefHeight="30.0" prefWidth="500.0" styleClass="text-area" />
               </children>
            </VBox>
      </children>
    </AnchorPane>
      <HBox id="navContainer" prefHeight="100.0" prefWidth="200.0">
         <children>
             <Button id="timedBtn" mnemonicParsing="false" onAction="#displayTimed" styleClass="navigation-btn" text="Timed">
                <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
             <Button id="homeBtn" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#displayHomepage" styleClass="navigation-btn" text="Home">
                 <HBox.margin>
                    <Insets right="30.0" />
                </HBox.margin>
             </Button>
            <Button id="statsBtn" mnemonicParsing="false" onAction="#displayStats" styleClass="navigation-btn" text="Statistics" />
         </children>
      </HBox>
  </children>
</VBox>
